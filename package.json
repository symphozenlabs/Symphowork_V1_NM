{
  "name": "symphowork-svelte-v1",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "24.16.x",
    "npm": ">=10.0.0 <12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
